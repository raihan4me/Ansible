# {{ ansible_managed }}
server {
    listen {{ web_port }} default_server;
    server_name _;
    root {{ web_root }};
    index index.html;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
